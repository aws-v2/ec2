### SSH Key Management API (Future Implementation)

@baseUrl = http://localhost:8080/api/v1

# @name CreateSSHKey
POST {{baseUrl}}/ssh-keys
Content-Type: application/json

{
    "name": "test-key",
    "public_key": "ssh-rsa  emqarani@gmail.com"
}

###

# @name ListSSHKeys
GET {{baseUrl}}/ssh-keys
Accept: application/json

###

# @name DeleteSSHKey
DELETE {{baseUrl}}/ssh-keys/{{keyId}}
Accept: application/json

### Variables
@keyId = 1
