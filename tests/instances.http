### Instance Management API

@baseUrl = http://localhost:8088/api/v1/ec2
@sshKey = ssh-rsa  emqarani@gmail.com



# @name ListInstances
GET {{baseUrl}}/instances
Accept: application/json

###

# @name CreateInstance
POST {{baseUrl}}/instances
Content-Type: application/json

{
    "image": "ubuntu-24.04",
    "cpu": 2,
    "ram": 2048,
    "ssh_key": "{{sshKey}}"
}

###

@instanceId = i-33c0ab42
# @name GetInstance
GET {{baseUrl}}/instances/{{instanceId}}
Accept: application/json

###

# @name StartInstance
POST {{baseUrl}}/instances/{{instanceId}}/start
Accept: application/json

###

# @name StopInstance
POST {{baseUrl}}/instances/{{instanceId}}/stop
Accept: application/json

###

# @name RestartInstance
POST {{baseUrl}}/instances/{{instanceId}}/restart
Accept: application/json

###

# @name DeleteInstance
DELETE {{baseUrl}}/instances/{{instanceId}}
Accept: application/json

###
# @name GetStatusChecks
GET {{baseUrl}}/instances/{{instanceId}}/status-checks
Accept: application/json

###
# @name GetMetrics
GET {{baseUrl}}/instances/{{instanceId}}/metrics
Accept: application/json