# EC2 Service Production Environment
APP_PROFILE=prod
PORT=8088
SERVICE_NAME=ec2-service

# Database
DB_HOST=postgres-prod
DB_PORT=5432
DB_USER=root
DB_PASSWORD=prod-db-password-change-me
DB_NAME=ec2_db
DB_SSLMODE=disable

# NATS
NATS_URL=nats://nats-prod:4222
NATS_USER=auth-server
NATS_PASSWORD=prod-nats-password-change-me

# Libvirt
LIBVIRT_URI=qemu:///system
IMAGES_DIR=/var/lib/libvirt/images

# MinIO
MINIO_ENDPOINT=minio-prod:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
