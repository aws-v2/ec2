<!-- /etc/libvirt/qemu/networks/serwin.xml -->
<network>
  <name>serwin</name>
  <forward mode="nat">
    <nat>
      <port start="1024" end="65535"/>
    </nat>
  </forward>
  <bridge name="virbr-serwin" stp="on" delay="0"/>
  <ip address="10.5.1.1" netmask="255.255.255.0">
    <dhcp>
      <range start="10.5.1.2" end="10.5.1.254"/>
    </dhcp>
  </ip>
</network>
